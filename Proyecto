//Cantidad de nombres que empiezan por la letra "e" en la matriz

public class matrizEjercicio4 {
    static void main() {
        String[][]nombres= {{"luisa","maria","pedro"},{"juan","camilo","sara"}, {"martin","mateo","melanie"}};

        int cantidadNombresM=0;
        for(int i=0; i<nombres.length; i++){ //filas
            for(int j=0; j<nombres[i].length; j++){ //columnas
                if(nombres[i][j].charAt(0)=='e'){
                    cantidadNombresM++;
                }
            }
        }

        System.out.println("La cantidad de nombres que empiezan por la letra e son: "+cantidadNombresM);
    }
}
